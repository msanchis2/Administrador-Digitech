# Copia este fichero como .env y rellena tus datos de Supabase.
# La "publishable/anon key" está pensada para viajar al navegador: la seguridad
# real la ponen las políticas RLS de Supabase, no el secreto de esta clave.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL de la Edge Function admin-create-user (opcional). Vacía = crear cuentas desde Supabase.
VITE_CREATE_USER_FN_URL=
